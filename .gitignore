# Build output: Rust targets at any depth (workspace and every spike) and the
# generated browser bindings. Cargo.lock files ARE tracked: they hold pins
# (libc 0.2.189 for iOS) that a fresh resolve would undo.
target/
spikes/wasm/pkg/
apps/web-ark-check/pkg/

# Local environment and secrets. Regtest credentials in infra/ are test-only.
.env
.env.*
!.env.example
*.pem
*.key
# Local Mutinynet setup state (infra/mutinynet-setup.sh)
infra/.mutinynet-funding-address
infra/.mutinynet-gateway-address
infra/.mutinynet-federation-invite
# Seeds and data of funded test wallets (test coins only). Never commit.
infra/.wallets/

# Editors and OS
.DS_Store
.vscode/
.idea/
*.swp
# iOS demo build outputs (demo/ios/build-rust.sh regenerates them)
demo/ios/build/
demo/ios/Generated/
demo/ios/IndigoFFI.xcframework/
demo/ios/IndigoDemo.xcodeproj/
